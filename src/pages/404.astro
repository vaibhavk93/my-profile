---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Vaibhav Kumawat" description="Page not found.">
  <section class="wrap py-24 max-w-2xl">
    <p class="eyebrow">404</p>
    <h1 class="mt-3" style="font-size:var(--fs-h1)">This page doesn't exist</h1>
    <p class="muted mt-4">Probably a moved case study. The good stuff is one click away:</p>
    <div class="mt-8 flex gap-4 flex-wrap">
      <a class="btn btn-gold" href="/#work">Case studies</a>
      <a class="btn btn-ghost" href="/">Home</a>
    </div>
  </section>
</Base>
